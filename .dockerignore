# Dependencies - reinstalled inside the image from the lockfile.
**/node_modules

# VCS / CI
.git
.github

# Build outputs - regenerated by the image's own build stage.
**/dist
**/build
**/.output
**/.tanstack
**/.vercel
.vercel
**/.turbo
.turbo
.nx

# Env files - secrets stay out of image layers; runtime config comes from
# compose's env_file plus the environment overrides in docker-compose.yml.
**/.env
**/.env.*
!**/.env.example

# Database files - mounted at runtime via the compose volume, never baked in.
data/
*.db
*.db-*
local.db*

# Docker/Podman assets themselves - editing these never needs to bust the
# COPY layers below them.
Dockerfile
**/Dockerfile
docker-compose.yml

# Unrelated apps and content - apps/map-scraper is a standalone Python tool,
# not part of the web image.
apps/map-scraper
plans/
*.md
LICENSE

# IDE / editor
.vscode
.idea
*.swp
*.swo

# Tests / coverage
coverage/
.nyc_output/
**/*.test.ts
**/*.test.tsx

# Misc
*.log
*.tgz
.cache
tmp/
temp/
