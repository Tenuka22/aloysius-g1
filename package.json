{
  "name": "aloysius-admissions",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.7.7",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "^1.7.3",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@orpc/client": "^1.14.12",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev",
    "build": "nx run-many -t build",
    "check-types": "nx run-many -t check-types",
    "test": "vitest run --execArgv=--no-webstorage",
    "test:integration": "bun test --isolate packages/api/src/routers/index.integration.test.ts packages/auth/src/index.integration.test.ts",
    "test:all": "bun run test && bun run test:integration",
    "dev:web": "nx run-many -t dev --projects=web",
    "dev:server": "nx run-many -t dev --projects=server",
    "db:push": "nx run-many -t db:push --projects=@aloysius-admissions/db",
    "db:studio": "nx run-many -t db:studio --projects=@aloysius-admissions/db",
    "db:generate": "nx run-many -t db:generate --projects=@aloysius-admissions/db",
    "db:migrate": "nx run-many -t db:migrate --projects=@aloysius-admissions/db",
    "db:auth": "nx run-many -t db:auth --projects=@aloysius-admissions/db",
    "db:seed": "nx run-many -t db:seed --projects=@aloysius-admissions/db",
    "podman:build": "podman compose -f docker-compose.yml build",
    "podman:up": "podman compose -f docker-compose.yml up -d --build",
    "podman:down": "podman compose -f docker-compose.yml down",
    "podman:logs": "podman compose -f docker-compose.yml logs -f",
    "docker:build": "docker compose -f packages/docker/docker-compose.yml build",
    "docker:up": "docker compose -f packages/docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f packages/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f packages/docker/docker-compose.yml logs -f",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@aloysius-admissions/env": "workspace:*",
    "@tanstack/react-table": "8",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aloysius-admissions/config": "workspace:*",
    "@biomejs/biome": "^1.9.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "nx": "^23.1.0",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.13"
}
