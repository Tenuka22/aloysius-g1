{
  "name": "aloysius-g1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "elysia": "^1.4.29",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.6.27",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@orpc/client": "^1.14.12",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev",
    "build": "nx run-many -t build",
    "check-types": "nx run-many -t check-types",
    "dev:web": "nx run-many -t dev --projects=web",
    "dev:server": "nx run-many -t dev --projects=server",
    "db:push": "nx run-many -t db:push --projects=@aloysius-g1/db",
    "db:studio": "nx run-many -t db:studio --projects=@aloysius-g1/db",
    "db:generate": "nx run-many -t db:generate --projects=@aloysius-g1/db",
    "db:migrate": "nx run-many -t db:migrate --projects=@aloysius-g1/db",
    "db:start": "podman compose -f docker-compose.yml up -d postgres",
    "db:watch": "podman compose -f docker-compose.yml up postgres",
    "db:stop": "podman compose -f docker-compose.yml stop postgres",
    "db:down": "podman compose -f docker-compose.yml down postgres",
    "podman:build": "podman compose -f docker-compose.yml build",
    "podman:up": "podman compose -f docker-compose.yml up -d --build",
    "podman:down": "podman compose -f docker-compose.yml down",
    "podman:logs": "podman compose -f docker-compose.yml logs -f",
    "docker:build": "docker compose -f packages/docker/docker-compose.yml build",
    "docker:up": "docker compose -f packages/docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f packages/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f packages/docker/docker-compose.yml logs -f"
  },
  "dependencies": {
    "@aloysius-g1/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aloysius-g1/config": "workspace:*",
    "@types/bun": "catalog:",
    "nx": "^23.1.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
