{
  "name": "@aloysius-admissions/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./scripts/*": {
      "default": "./scripts/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "bun --env-file ../../apps/server/.env scripts/backup.ts && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "bun --env-file ../../apps/server/.env scripts/backup.ts && drizzle-kit migrate",
    "db:backup": "bun --env-file ../../apps/server/.env scripts/backup.ts",
    "db:restore": "bun --env-file ../../apps/server/.env scripts/restore.ts",
    "db:auth": "bun scripts/generate-auth-schema.ts",
    "db:seed": "bun --env-file ../../apps/server/.env src/seed.ts"
  },
  "dependencies": {
    "@aloysius-admissions/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aloysius-admissions/config": "workspace:*",
    "@libsql/client": "^0.17.4",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
