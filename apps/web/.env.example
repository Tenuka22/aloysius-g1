# Copy to apps/web/.env and fill in real values before `bun run dev` or
# `docker compose up`. See README.md#environment for details on each var.
# Every value here is a placeholder - none of it is a real secret.

# A local `file:` path for development (relative values resolve from the
# repo root), or a `libsql://<db>.turso.io` URL for a hosted Turso database.
# `docker compose up` always overrides this to the volume-backed file in
# docker-compose.yml, regardless of what's set here.
TURSO_DATABASE_URL=file:../../data/local.db
# Only required when TURSO_DATABASE_URL above is a remote Turso URL.
TURSO_AUTH_TOKEN=

# At least 32 characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-character-secret

# Public origin the app is served from. Must match how you're reaching it.
BETTER_AUTH_URL=http://localhost:3001

NODE_ENV=development

# Site-admin account seeded on first boot. Rotate before deploying.
ADMIN_PASSWORD=admin123456
# Sub-admin account(s): password below, comma-separated logins.
SUB_ADMIN_PASSWORD=subadmin123456
SUB_ADMIN_EMAILS=subadmin@aloysiuscollege.lk
